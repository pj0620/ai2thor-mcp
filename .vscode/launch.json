  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "debugpy",
      "request": "launch",
      "program": "python/ai2thor_mcp/main.py",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Some Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-s",
        "regression/test_ai2thor_mcp.py"
      ],
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONDONTWRITEBYTECODE":"1"
      }
    }
  ]
}